# Copie para .env e ajuste. Nunca commite o .env.
APP_NAME=review-redirect
ENVIRONMENT=development

# Usado pelo serviço db do Compose
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=review_redirect

# Execução local fora do Docker (host localhost). Dentro do Compose, o host é
# sobrescrito automaticamente para "db".
DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/review_redirect

# Porta do banco exposta no host (apenas dev); mude se 5432 estiver ocupada
# DB_HOST_PORT=5432

# Banco exclusivo para testes automatizados de integração (deve terminar obrigatoriamente com _test)
TEST_DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/review_redirect_test

# Configurações de Sessão e Segurança de Cookies (Fase 4a)
SESSION_COOKIE_NAME=session_id
SESSION_TTL_HOURS=12
# Em produção deve ser true (HTTPS obrigatório). Em desenvolvimento local HTTP sem TLS pode ser false:
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_BASE_URL=
