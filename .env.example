# Copie para .env e ajuste. Nunca commite o .env.
APP_NAME=review-redirect
ENVIRONMENT=development

# Usado pelo serviço db do Compose
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=review_redirect

# Execução local fora do Docker (host localhost). Dentro do Compose, o host é
# sobrescrito automaticamente para "db".
DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/review_redirect

# Porta do banco exposta no host (apenas dev); mude se 5432 estiver ocupada
# DB_HOST_PORT=5432
